{
  "name": "backend",
  "version": "1.0.0",
  "description": "Developed by AIAutomation Lab",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node tests/production_test_suite.js",
    "build": "npx prisma generate && npx prisma db push",
    "build:exe": "pkg server.js --target node18-win-x64 --output dist/server.exe"
  },
  "pkg": {
    "scripts": [
      "server.js"
    ],
    "assets": [
      "prisma/**/*",
      "node_modules/.prisma/client/*",
      "node_modules/@prisma/client/**/*"
    ]
  },
  "keywords": [],
  "author": "AIAutomation Lab",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "axios": "^1.15.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
