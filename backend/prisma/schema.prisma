generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id                 Int       @id @default(autoincrement())
  code               String?   @unique 
  salutation         String?   @default("Dr.")
  name               String    
  contactPerson      String?
  doctorName         String?
  regNum             String?
  workingHours       String?
  salesManager       String?

  email              String?
  phone              String?
  phone2             String?
  cellPhone          String?
  cellPhone2         String?
  
  city               String?
  area               String?
  pinCode            String?
  address            String?
  address2           String?
  
  deliveryMethod     String?   @default("Courier")
  route              String?   @default("Default")
  priceBand          String?   @default("Standard")
  taxId              String?
  creditLimit        Float?    @default(0)
  paymentTermsDays   Int?      @default(0)
  openingBalance     Float?    @default(0)
  openingBalanceType String?   @default("Dr")
  categories         String?
  
  defaultDeliveryAgent String?
  collectionCentre     String?
  regularVisits        String?
  taxExemption         Boolean   @default(false)
  isDentalLab          Boolean   @default(false)
  billTo               String?   @default("Self")

  trn                String?
  discountPercentage Float?    @default(0)
  priceListCategory  String?
  status             String    @default("Active")
  notes              String?
  advanceBalance     Float     @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  
  orders             Order[]
  invoices           Invoice[]
  receipts           Receipt[]
  shipmentNotes      ShipmentNote[]
  adjustments        Adjustment[]
  pickupRequests     PickupRequest[]
}

model PickupRequest {
  id             Int       @id @default(autoincrement())
  clientId       Int
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  patientName    String?
  productType    String?
  doctorName     String?
  requestDate    DateTime  @default(now())
  pickupDate     DateTime?
  status         String    @default("Pending") // Pending, Completed, Cancelled
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([requestDate])
}

model Order {
  id           Int       @id @default(autoincrement())
  orderNumber  String?   @unique
  orderType    String    @default("New") // New, Repeat, Repair
  
  clientId     Int
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  doctorName   String?
  
  patientName  String
  gender       String?
  age          Int?
  
  productType  String?    
  productName  String?   
  material     String?
  
  teethSelection String? 
  
  shade1       String?
  shade2       String?
  shade3       String?
  shadeNotes   String?
  stumpShade   String?
  
  priority     String    @default("Normal")
  status       String    @default("Received") 
  
  receivedDate DateTime  @default(now())
  dueDate      DateTime?
  trialDate    DateTime?
  finishDate   DateTime?
  
  hasUpperImpression Boolean @default(false)
  hasLowerImpression Boolean @default(false)
  hasBite           Boolean @default(false)
  hasWaxUp          Boolean @default(false)
  hasOldRestoration Boolean @default(false)
  hasArticulator    Boolean @default(false)
  hasPhotos         Boolean @default(false)
  
  notes        String?
  options      String?   // JSON string representing selected custom product options
  units        Int       @default(1)
  price        Float     @default(0)
  discount     Float     @default(0)
  tax          Float     @default(0)
  totalAmount  Float     @default(0)
  
  // Slabs for RPD
  slab1Rate    Float?
  slab2Rate    Float?
  slab1Units   Int?
  slab2Units   Int?

  grossAmount    Float     @default(0)
  discountAmount Float     @default(0)
  taxAmount      Float     @default(0)
  netAmount      Float     @default(0)

  technician   String?
  department   String?
  
  modelNumber    String?
  panTrayNumber  String?
  deliveryMethod String?
  articulatorTag String?
  manufacturer   String?
  subDoctor      String?
  dropLocation   String?
  timeSlot       String?   // Morning/Afternoon
  
  shippingStatus String?   @default("Pending") // Pending, Dispatched, Delivered, Returned
  
  shipmentNoteId Int?
  shipmentNote   ShipmentNote? @relation(fields: [shipmentNoteId], references: [id], onDelete: SetNull)
  
  invoiceId    Int?
  invoice      Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  
  warranty     Warranty?
  pickupReturns PickupReturn[]
  media        Media[]
  jobs         OrderJob[]
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  holdFrom       DateTime?
  holdReason     String?
  cancelledOn    DateTime?
  cancelledReason String?

  @@index([clientId])
  @@index([status])
  @@index([receivedDate])
  @@index([dueDate])
  @@index([invoiceId])
  @@index([shipmentNoteId])
  @@index([orderNumber])
  @@index([clientId, status])
  @@index([shippingStatus])
}

model OrderJob {
  id             Int      @id @default(autoincrement())
  orderId        Int
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productType    String    
  productName    String?   
  material       String?
  teethSelection String? 
  
  shade1         String?
  shade2         String?
  shade3         String?
  shadeNotes     String?
  stumpShade     String?
  options        String?   // JSON string representing selected custom product options
  
  units          Int      @default(1)
  price          Float    @default(0) // Unit Rate
  totalAmount    Float    @default(0) // units * price or slab calc
  
  slab1Rate      Float?
  slab2Rate      Float?
  slab1Units     Int?
  slab2Units     Int?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orderId])
  @@index([productName])
}

model Media {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  url       String
  filename  String?
  mimetype  String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

model ShipmentNote {
  id             Int       @id @default(autoincrement())
  noteNumber     String    @unique
  clientId       Int
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  noteDate       DateTime  @default(now())
  type           String    @default("Final") // Final, TryIn
  status         String    @default("Created") // Created, Printed, Dispatched, Delivered
  
  deliveryMode   String?
  notes          String?

  orders         Order[]
  
  deliveryPlanId Int?
  deliveryPlan   DeliveryPlan? @relation(fields: [deliveryPlanId], references: [id])
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([noteDate])
}

model DeliveryPlan {
  id             Int       @id @default(autoincrement())
  planDate       DateTime  @default(now())
  route          String?
  driverId       Int?
  driver         Staff?    @relation(fields: [driverId], references: [id])
  status         String    @default("Scheduled") // Scheduled, In Progress, Completed
  
  shipmentNotes  ShipmentNote[]
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([driverId])
  @@index([status])
  @@index([planDate])
}

model PickupReturn {
  id             Int       @id @default(autoincrement())
  orderId        Int
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemType       String?   // Impression, Wax Trial, etc.
  status         String    @default("Pending Pickup") // Pending Pickup, Received at Lab
  pickupDate     DateTime?
  receivedDate   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([orderId])
  @@index([status])
}

model Invoice {
  id            Int       @id @default(autoincrement())
  invoiceNumber String    @unique
  clientId      Int
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoiceDate   DateTime  @default(now())
  dueDate       DateTime?
  grossAmount     Float     @default(0)
  discountAmount  Float     @default(0)
  taxAmount       Float     @default(0)
  netAmount       Float     @default(0)
  paidAmount    Float     @default(0)
  balanceAmount Float
  status        String    @default("Unpaid") // Unpaid, Partial, Paid
  orders         Order[]
  adjustments    Adjustment[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([invoiceDate])
}

model Receipt {
  id            Int       @id @default(autoincrement())
  receiptNumber String    @unique
  receiptDate   DateTime  @default(now())
  clientId      Int
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  amount        Float
  appliedAmount Float     @default(0)
  creditAmount  Float     @default(0)
  paymentMode   String?   // Cash, Bank, Cheque
  isAdvance     Boolean   @default(false)
  chequeNumber  String?
  chequeDate    DateTime?
  bankName      String?
  reference     String?   // Transaction ID
  notes         String?
  status        String    @default("Active") // Active, Cancelled
  cancelledOn   DateTime?
  cancelledReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([clientId])
  @@index([receiptDate])
  @@index([status])
}

model Adjustment {
  id             Int       @id @default(autoincrement())
  adjustmentNumber String    @unique
  date           DateTime  @default(now())
  clientId       Int
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoiceId      Int?
  invoice        Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  type           String    // Credit, Debit
  amount         Float
  reason         String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([clientId])
  @@index([invoiceId])
  @@index([date])
}

model Expense {
  id          Int      @id @default(autoincrement())
  voucherNo   String?  @unique
  date        DateTime @default(now())
  amount      Float
  paidTo      String?
  paymentMode String?  // Cash, Cheque, Online
  reference   String?  // Cheque/Ref No
  notes       String?
  category    String?  @default("General")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([paidTo])
}

model Warranty {
  id              Int      @id @default(autoincrement())
  orderId         Int      @unique
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  durationYears   Int
  startDate       DateTime @default(now())
  terms           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Staff {
  id        Int      @id @default(autoincrement())
  name      String
  role      String?
  contact   String?
  salary    Float?
  department String?
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  deliveryPlans DeliveryPlan[]
}

model Material {
  id           Int      @id @default(autoincrement())
  name         String
  category     String?
  stock        Float    @default(0)
  unit         String?
  minStock     Float?
  code         String?
  version      String?
  favourite    Boolean  @default(false)
  purchaseUnit String?
  stdUnit      String?
  purchaseRate Float?   @default(0)
  retailPrice  Float?   @default(0)
  taxPercent   Float?   @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  inventoryTransactions InventoryTransaction[]

  @@index([category])
  @@index([name])
}

model InventoryTransaction {
  id           Int       @id @default(autoincrement())
  docNumber    String?
  type         String    // Inward, Outward, Adjustment
  materialId   Int
  material     Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  materialName String?
  quantity     Float
  date         DateTime  @default(now())
  supplier     String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([materialId])
  @@index([type])
  @@index([date])
}

model Product {
  id               Int      @id @default(autoincrement())
  name             String
  code             String?
  type             String?
  charge           Float    @default(0)
  warranty         Int?     @default(0)
  completionPeriod Int?     @default(0)
  unitSelection    String?  @default("Teeth")
  useSlabPricing   Boolean? @default(false)
  slab1Rate        Float?   @default(0)
  slab2Rate        Float?   @default(0)
  slab1Units       Int?     @default(0)
  slab2Units       Int?     @default(0)
  priceBands       String?  // JSON string for price band configurations
  notes            String?
  inactive         Boolean? @default(false)
  category         String?
  color            String?
  tryins           String?  // JSON string representing Try In options
  options          String?  // JSON string representing Product Options table
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([name])
  @@index([type])
}

model ProductType {
  id          Int      @id @default(autoincrement())
  name        String
  category    String?
  color       String?
  tryins      String?  // JSON string representing Try In options
  options     String?  // JSON string representing Product Options table
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model SettingLookup {
  id        Int      @id @default(autoincrement())
  type      String
  name      String
  value     String?
  createdAt DateTime @default(now())

  @@index([type])
}

model DropdownOption {
  id            Int      @id @default(autoincrement())
  page          String   // page/module name (e.g. "Order", "Shipment", "Account")
  dropdownKey   String   // unique dropdown key
  dropdownLabel String   // human-readable label of the dropdown
  optionLabel   String   // displayed label of the option
  optionValue   String   // internal value of the option
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([dropdownKey])
  @@index([page])
}

